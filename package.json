{
  "name": "@astrale-os/workspace-config",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/config.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"try{require('./.check-workspace.cjs')}catch{}\"",
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "pnpm test:action-pins && pnpm test:action-defaults && pnpm test:install-boundary && pnpm test:domains && pnpm test:github && pnpm test:jsr-publish && pnpm test:publish-packages && pnpm test:publish-mirror && pnpm -r --if-present run test",
    "test:action-pins": "node --test .github/actions/action-pins.test.mjs",
    "test:action-defaults": "node --test .github/actions/frozen-lockfile-defaults.test.mjs .github/actions/release/*.test.mjs",
    "test:install-boundary": "node --test .github/actions/install-dependencies.test.mjs",
    "test:domains": "node --test .github/actions/domains/*.test.mjs",
    "test:github": "node --test github/repository-policy/*.test.mjs",
    "test:jsr-publish": "node --test .github/actions/publish/jsr/check-published.test.mjs",
    "test:publish-packages": "node --test .github/actions/publish/packages/*.test.mjs",
    "test:publish-mirror": "node --test .github/actions/publish/mirror-npm-to-github/*.test.mjs",
    "github:repositories:check": "node github/repository-policy/reconcile.mjs --check",
    "github:repositories:apply": "node github/repository-policy/reconcile.mjs --apply",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrale-os/ox": "workspace:*",
    "@commitlint/cli": "~21.2.2",
    "@commitlint/config-conventional": "~21.2.2",
    "husky": "~9.1.7",
    "lint-staged": "~17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{js,cjs,mjs}": [
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@12.0.0"
}
