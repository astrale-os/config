{
  "name": "@astrale-os/workspace-config",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/config.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node .check-workspace.cjs",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint --fix -c oxlint.json .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "pnpm -r run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "husky": "~9.1.7",
    "lint-staged": "~16.2.7",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "~6.0.1-rc"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts}": [
      "oxlint --fix -c oxlint.json",
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
